{
  "name": "mirai-style-checker",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "postCreateCommand": "pip install --upgrade pip && pip install mcp pyyaml",
